---
// Newsletter-Anmeldung über Netlify Forms: Einsendungen erscheinen im
// Netlify-Dashboard unter "Forms" und können von dort exportiert werden
// (später z. B. an Brevo o. Ä. anbindbar).
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<div class:list={['newsletter', { 'newsletter--compact': compact }]}>
  {!compact && <p class="newsletter__eyebrow">Newsletter</p>}
  <h3 class="newsletter__title">Natürliche Impulse ins Postfach</h3>
  <p class="newsletter__text">
    Rezepte, sanfte Entgiftungs-Tipps und natürliche Tiergesundheit – etwa
    zweimal im Monat, jederzeit abbestellbar.
  </p>
  <form
    name="newsletter"
    method="POST"
    action="/danke/"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="newsletter__form"
  >
    <input type="hidden" name="form-name" value="newsletter" />
    <p class="visually-hidden" aria-hidden="true">
      <label>Bitte nicht ausfüllen: <input name="bot-field" /></label>
    </p>
    <div class="newsletter__row">
      <label class="visually-hidden" for={`nl-email-${compact ? 'c' : 'a'}`}>E-Mail-Adresse</label>
      <input
        id={`nl-email-${compact ? 'c' : 'a'}`}
        type="email"
        name="email"
        placeholder="deine@email.de"
        required
      />
      <button class="btn" type="submit">Anmelden</button>
    </div>
    <p class="newsletter__consent">
      Mit der Anmeldung stimmst du zu, dass ich dir E-Mails mit Tipps und
      gelegentlichen Produktempfehlungen sende. Hinweise zum Datenschutz findest
      du in der <a href="/datenschutz/">Datenschutzerklärung</a>.
    </p>
  </form>
</div>
