---
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import FreebieBox from '../components/FreebieBox.astro';
import { getCategory } from '../categories';
import { AUTHOR } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  heroAlt?: string;
  heroImage?: string;
  affiliate?: boolean;
}
const { title, description, pubDate, category, heroAlt, heroImage, affiliate } = Astro.props;
const cat = getCategory(category);
// Bei Tiergesundheit steht am Artikelende das Freebie statt der allgemeinen
// Newsletter-Anmeldung – es ist das konkretere Angebot für dieselbe Leserin
// und führt über die Bestätigungsstrecke ohnehin in den Newsletter.
const zeigeFreebie = category === 'tiergesundheit';
const dateStr = pubDate.toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---
<BaseLayout title={title} description={description} image={heroImage}>
  <div class="container layout">
    <article class="layout__main article">
      <header class="article__header">
        <p class="article__meta">
          {cat && <a href={`/kategorie/${cat.slug}/`}>{cat.title}</a>}
          <span> · {dateStr} · von {AUTHOR.name}</span>
        </p>
        <h1>{title}</h1>
        {affiliate && (
          <p class="affiliate-note">
            Dieser Artikel enthält Werbelinks (Affiliate-Links). Was das bedeutet,
            erfährst du auf der Seite <a href="/transparenz/">Transparenz</a>.
          </p>
        )}
      </header>

      <ImagePlaceholder label={heroAlt || title} variant="hero" src={heroImage} alt={heroAlt || title} />

      <div class="prose">
        <slot />
      </div>

      {zeigeFreebie ? <FreebieBox variant="artikel" /> : <NewsletterSignup />}
    </article>

    <aside class="layout__aside">
      <AuthorBox />
      {zeigeFreebie && (
        <div class="widget">
          <FreebieBox variant="widget" />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
